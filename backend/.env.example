# --- Required ---
# Postgres connection string. Managed providers (Neon, Supabase, Railway, Render)
# hand you this; most hosted databases need ?sslmode=require appended.
DATABASE_URL="postgresql://churnrate:churnrate@localhost:5433/churnrate?schema=public"

# Signs auth tokens. Generate with: openssl rand -base64 32
JWT_SECRET="change-me-in-production"

# Comma-separated list of frontend origins allowed to call this API
# (REST + WebSocket). No trailing slashes.
CORS_ORIGINS="http://localhost:3000"

# --- Recommended ---
# Encrypts third-party credentials (e.g. Stripe keys) at rest.
# Generate with: openssl rand -hex 32
# Falls back to a key derived from JWT_SECRET when unset — set it explicitly in
# production, otherwise rotating JWT_SECRET orphans stored credentials.
ENCRYPTION_KEY=""

# --- Optional ---
JWT_EXPIRY="7d"
PORT=3001
NODE_ENV=development

# Python churn model service. When unreachable the API falls back to a
# deterministic rule-based score, so this is not required to boot.
ML_SERVICE_URL="http://localhost:8001"

# Reserved for future queue-backed jobs; the API runs without it.
REDIS_URL="redis://localhost:6379"
