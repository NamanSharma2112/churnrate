# Base URL of the ChurnRate API. Must be reachable from the browser, so use the
# public URL of your deployed backend — not an internal hostname.
# These are inlined into the client bundle at build time; changing them requires
# a rebuild, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Socket.IO endpoint. Normally the same origin as the API.
NEXT_PUBLIC_WS_URL=http://localhost:3001
